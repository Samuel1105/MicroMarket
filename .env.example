# Copia este archivo como .env y completa los valores. NO subas el .env a GitHub.

# Base de datos SQL Server
# Local (autenticación de Windows):
DATABASE_URL="sqlserver://localhost:1433;database=MicroMarketDefense;integratedSecurity=true;trustServerCertificate=true;encrypt=false"
# Somee (hosting):
# DATABASE_URL="sqlserver://TU-SERVIDOR.mssql.somee.com:1433;database=TU_BASE;user=TU_USUARIO;password=TU_CLAVE;encrypt=true;trustServerCertificate=true;"

# Correo para enviar las proformas (SMTP). Ejemplo con Gmail y "contraseña de aplicación":
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Opcional: remitente que se muestra (por defecto, SMTP_USER). Algunos proveedores exigen un remitente verificado.
# SMTP_FROM="tu-correo@gmail.com"

# Opcional: teléfono del negocio, para el pie de la proforma y del correo
# NEGOCIO_TELEFONO="+591 7xxxxxxx"
